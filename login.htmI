<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supabase Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
      :root {
        --bg: #0f172a;
        --panel: #111827;
        --panel-light: #1f2937;
        --border: rgba(148, 163, 184, 0.3);
        --text: #e5e7eb;
        --muted: #94a3b8;
        --primary: #38bdf8;
        --primary-dark: #0284c7;
        --success: #22c55e;
        --danger: #ef4444;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #020617, #111827 40%, #0f172a);
        color: var(--text);
        font-family: Arial, sans-serif;
      }

      .card {
        width: min(420px, 92vw);
        background: rgba(17, 24, 39, 0.95);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.55);
        padding: 2rem;
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: 2rem;
      }

      .subtitle {
        margin: 0 0 1.5rem;
        color: var(--muted);
      }

      form {
        display: grid;
        gap: 1rem;
      }

      label {
        display: grid;
        gap: 0.45rem;
        font-weight: 600;
        color: var(--text);
      }

      input {
        width: 100%;
        padding: 0.9rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: rgba(15, 23, 42, 0.9);
        color: var(--text);
        font-size: 1rem;
      }

      input:focus {
        outline: 2px solid rgba(56, 189, 248, 0.7);
        border-color: var(--primary);
      }

      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        margin-top: 0.5rem;
      }

      button {
        border: none;
        border-radius: 10px;
        padding: 0.9rem 1rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .primary {
        background: var(--primary);
        color: #082f49;
      }

      .primary:hover { background: #7dd3fc; }

      .secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
      }

      .secondary:hover { background: rgba(255,255,255,0.04); }

      .message {
        margin-top: 1rem;
        min-height: 24px;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .message.success { color: var(--success); }
      .message.error { color: var(--danger); }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Welcome back</h1>
      <p class="subtitle">Sign in to continue</p>

      <form id="loginForm">
        <label>
          Email
          <input id="email" type="email" placeholder="you@example.com" required />
        </label>

        <label>
          Password
          <input id="password" type="password" placeholder="••••••••" required />
        </label>

        <div class="actions">
          <button class="primary" type="submit">Login</button>
          <button class="secondary" type="button" id="signUpBtn">Create account</button>
        </div>
      </form>

      <div id="message" class="message" aria-live="polite"></div>
    </div>

    <script>
      const supabaseUrl = 'https://ezjfyyoguyknxepjfcrs.supabase.co';
      const supabaseKey = 'sb_publishable_pRj6SP-YfxQFwOxRdXtotw_O7K7TtTX';
      const supabase = supabaseJs.createClient(supabaseUrl, supabaseKey);

      const loginForm = document.getElementById('loginForm');
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const message = document.getElementById('message');
      const signUpBtn = document.getElementById('signUpBtn');

      function showMessage(text, type = 'info') {
        message.textContent = text;
        message.className = 'message';
        if (type === 'success') message.classList.add('success');
        if (type === 'error') message.classList.add('error');
      }

      async function redirectIfSignedIn() {
        const { data: { session }, error } = await supabase.auth.getSession();
        if (!error && session) {
          window.location.href = 'dashboard.html';
        }
      }

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const email = emailInput.value.trim();
        const password = passwordInput.value.trim();

        if (!email || !password) {
          showMessage('Please enter your email and password.', 'error');
          return;
        }

        showMessage('Signing in...');

        const { data, error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          showMessage(error.message, 'error');
          return;
        }

        showMessage('Login successful! Redirecting...', 'success');
        setTimeout(() => {
          window.location.href = 'dashboard.html';
        }, 800);
      });

      signUpBtn.addEventListener('click', async () => {
        const email = emailInput.value.trim();
        const password = passwordInput.value.trim();

        if (!email || !password) {
          showMessage('Enter email and password to create an account.', 'error');
          return;
        }

        showMessage('Creating account...');

        const { data, error } = await supabase.auth.signUp({ email, password });

        if (error) {
          showMessage(error.message, 'error');
          return;
        }

        showMessage('Account created. Check your email to confirm your sign up.', 'success');
      });

      redirectIfSignedIn();
    </script>
  </body>
</html>
